# ─────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─────────────────────────────────────────
# DATABASE
# How to get:
# 1. Go to mongodb.com/atlas
# 2. Create free M0 cluster
# 3. Click Connect → Drivers → copy connection string
# 4. Replace <password> with your database user password
# ─────────────────────────────────────────
MONGODB_URI=your_mongodb_uri_here
# ─────────────────────────────────────────
# JWT SECRETS
# How to generate:
# Run in terminal: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Generate TWO different strings - one for each secret
# ─────────────────────────────────────────
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─────────────────────────────────────────
# AI SERVICES
# Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here
# Model used for the AI student, scoring, notes and voice transcription.
# Optional — defaults to gemini-3.5-flash-lite if unset.
# Free-tier request quotas are counted PER MODEL, so switching model
# gives a fresh daily allowance. Requires a server restart (.env is not
# watched by nodemon).
# Must support AUDIO input, since voice mode transcribes through it.
# Known working: gemini-3.5-flash-lite, gemini-3.1-flash-lite,
# gemini-2.5-flash-lite. Note gemini-2.5-flash now returns 404.
GEMINI_MODEL=gemini-3.5-flash-lite
# ─────────────────────────────────────────
# EMAIL (Brevo - free, 300/day)
# 1. Sign up at brevo.com (no credit card needed)
# 2. Settings → Senders & IP → Senders → Add a sender
#    (use any email address you own, e.g. your Gmail)
# 3. Brevo emails a verification link to that address — click it
# 4. Settings → SMTP & API → API Keys → generate a new key
# ─────────────────────────────────────────
BREVO_API_KEY=your_brevo_api_key_here
# The address verified in step 2 above — sends fail if it doesn't match
EMAIL_FROM=your_verified_sender@example.com
# ─────────────────────────────────────────
# FRONTEND URL (for CORS)
# May hold several origins, comma-separated:
#   FRONTEND_URL=http://localhost:5173,https://your-app.vercel.app
# ─────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─────────────────────────────────────────
# APP URL (for links inside emails)
# ONE url, no trailing slash — this is where reset and welcome links
# point. Kept separate from FRONTEND_URL because that one is a list,
# and a list pasted into a link produces a dead address.
# Locally: http://localhost:5173
# Deployed: your real frontend url
# ─────────────────────────────────────────
APP_URL=http://localhost:5173