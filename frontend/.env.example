# ─────────────────────────────────────────
# API URL
# Where the backend is reachable from the browser.
# Local dev: the backend's own port.
# Deployed:  your Render URL, e.g. https://mentora-ai.onrender.com/api
# Vite only exposes variables that start with VITE_.
# ─────────────────────────────────────────
VITE_API_URL=http://localhost:5000/api

# Shown in the browser tab and a few headings
VITE_APP_NAME=Mentora AI
